{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "background": "canvas",
  "terminal_padding": [14, 12],
  "divider": { "width": 1, "color": "border" },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 248 },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        { "id": "chrome", "type": "block", "size": { "px": 42 }, "window_drag": true, "content": { "mod": "workspace-chrome" } },
        { "id": "spaces", "type": "block", "content": { "mod": "spaces" } },
        { "id": "agents", "type": "block", "size": { "weight": 0.55 }, "content": { "mod": "agents" } }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        { "id": "tabs", "type": "block", "size": { "px": 42 }, "window_drag": true, "content": { "mod": "tabs" } },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": { "tab": "active", "pane": {
                "gap": 8, "radius": 10, "background": "background", "lone": true,
                "border": { "width": 1, "color": "border" },
                "focus": { "width": 1, "color": "accent" },
                "header": { "content": { "mod": "pane" }, "height": 30, "position": "top", "reveal": "always" }
              } }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": { "weight": 0.526 },
              "min": 280,
              "max": 900,
              "children": [
                { "id": "panel-body", "type": "stack", "active": "files", "children": [
                  { "id": "files", "type": "block", "content": { "mod": "files" } },
                  { "id": "changes", "type": "block", "content": { "mod": "changes" } }
                ] }
              ]
            },
            {
              "id": "workboard",
              "type": "block",
              "hidden": true,
              "size": { "weight": 0.566 },
              "min": 280,
              "max": 700,
              "background": "background",
              "border": { "width": 1, "color": "border" },
              "radius": 10,
              "content": { "mod": "workboard", "props": { "role": "panel" } }
            }
          ]
        },
        {
          "id": "status",
          "type": "row",
          "size": { "px": 30 },
          "resizable": false,
          "children": [
            { "id": "workspace-status", "type": "block", "content": { "mod": "workspace-status" } },
            { "id": "workboard-status", "type": "block", "size": { "px": 360 }, "content": { "mod": "workboard", "props": { "role": "status" } } }
          ]
        }
      ]
    }
  ]
}
